# Browser-safe configuration. These are the only allowed NEXT_PUBLIC_ names.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=synthetic-local-publishable-key
NEXT_PUBLIC_RELEASE_ID=local-development
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# Server-only infrastructure. Blank values must be supplied through an ignored
# .env.local file or the environment; never place real values in this template.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RAW_STORAGE_CREDENTIAL=
PROCESSED_STORAGE_CREDENTIAL=
QUEUE_SIGNING_SECRET=

# Real providers remain disabled until an approved decision and budget exist.
PROVIDER_MODE=mock
APPROVED_PROVIDER_BUDGET_MINOR=0
GENERATION_PROVIDER_ENABLED=false
GENERATION_PROVIDER_API_KEY=
EMBEDDING_PROVIDER_ENABLED=false
EMBEDDING_PROVIDER_API_KEY=
TRANSCRIPTION_PROVIDER_ENABLED=false
TRANSCRIPTION_PROVIDER_API_KEY=

# Bounded operational limits.
MAX_MESSAGE_CHARACTERS=12000
MAX_UPLOAD_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=1800
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_MS=60000
PROVIDER_CONCURRENCY=4
PROVIDER_RETRY_COUNT=3
DAILY_STUDENT_QUOTA=50
